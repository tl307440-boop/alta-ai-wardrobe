# Production environment template for /opt/alta_wardrobe/.env
# Copy to .env on the server and replace placeholder values with strong random secrets.
APP_PORT=8680
MYSQL_DATABASE=ai_wardrobe
MYSQL_USER=wardrobe
MYSQL_PASSWORD=replace_with_strong_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
APP_JWT_SECRET=replace_with_64_hex_chars_secret
APP_CRYPTO_SECRET=replace_with_48_hex_chars_secret
